# Machine-specific paths. Copy to .env at the repository root (git ignores it) or export the variables in the shell:
#   cp configs/paths.example.env .env            # read by r2ai.paths (process environment wins over .env)
#   set -a; . configs/paths.example.env; set +a  # bash: export for scripts/*.sh and python -m r2ai.reproduce
# Forward slashes also on Windows (D:/r2ai-root). Nothing here is needed when the packages are extracted into the repository itself.

# Directory the data packages of DATA.md were extracted into (holds data/, out/runs/, submissions/).
# Default of python -m r2ai.reproduce --root.
R2AI_ROOT=/path/to/r2ai-root

# Read roots of the library (r2ai.paths). The reproduce scripts derive them from R2AI_ROOT themselves.
R2AI_DATA_DIR=/path/to/r2ai-root/data
R2AI_OUT_DIR=/path/to/r2ai-root/out
# Required by r2ai.paths when R2AI_DATA_DIR is outside the repository: a write guard, any directory that does not exist is fine.
R2AI_OLD_ROOT=/path/to/r2ai-root/.no-old-root

# Hugging Face cache with the pinned models of MODELS.md; offline after the first download.
HF_HOME=/path/to/hf_home
HF_HUB_OFFLINE=1

# Windows only: Git Bash for the scripts (not the WSL bash of System32).
# R2AI_BASH=C:/Program Files/Git/bin/bash.exe
